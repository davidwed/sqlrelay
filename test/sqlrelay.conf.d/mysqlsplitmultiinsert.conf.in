<?xml version="1.0"?>
<instances>

	<instance id="mysqlsplitmultiinserttest" dbase="mysql">
		<listeners>
			<listener port="9000" socket="/tmp/test.socket"/>
		</listeners>
                <translations>
                        <translation module="normalize"/>
                </translations>
                <triggers>
                        <trigger module="splitmultiinsert" when="before"/>
                </triggers>
		<connections>
			<connection string="host=mysql;user=testuser;password=testpassword;db=@HOSTNAME@;foundrows=yes;autocommit=yes"/>
		</connections>
	</instance>

</instances>
